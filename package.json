{
  "name": "timurs-photo-shop",
  "version": "1.0.0",
  "description": "Local sample gallery for Timurs photography shop",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "db:start": "node scripts/db.mjs start",
    "db:stop": "node scripts/db.mjs stop",
    "test": "tsx --test tests/*.test.ts",
    "test:uploads:http": "node --conditions=react-server --import tsx scripts/check-upload-http.mjs",
    "admin:add": "node scripts/admin-add.mjs",
    "mail:flush": "node --conditions=react-server --import tsx scripts/mail-flush.ts",
    "test:integration": "node --conditions=react-server --import tsx --test tests/integration/*.test.ts"
  },
  "type": "module",
  "private": true,
  "dependencies": {
    "next": "^16.4.3",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5",
    "stripe": "^23.1.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
